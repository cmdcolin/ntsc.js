{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "browser": true
  },
  "ignorePatterns": ["dist", "scripts", "**/*.mjs"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // Vite's automatic JSX runtime never needs React in scope.
    "react/react-in-jsx-scope": "off",
    // Render-prop callbacks (e.g. Popover's `trigger`) are values, not components.
    "react/no-unstable-nested-components": ["error", { "allowAsProps": true }],
    "typescript/restrict-template-expressions": [
      "error",
      { "allowNumber": true }
    ],
    "typescript/no-confusing-void-expression": [
      "error",
      { "ignoreArrowShorthand": true }
    ],
    "no-empty-function": ["error", { "allow": ["arrowFunctions"] }]
  },
  "overrides": [
    {
      "files": ["src/version.ts"],
      "rules": {
        // __APP_VERSION__/__GIT_SHA__ are Vite `define` globals (vite.config.ts) — the
        // dangling underscores are the convention, not a naming choice to fix.
        "no-underscore-dangle": "off"
      }
    },
    {
      // Tests are linted like everything else — they were ignored outright until
      // the ignore pattern came off, which is how thirty-four of them went
      // unchecked while twelve `*.spec.ts` files did not. Two rules are switched
      // back off here because they are about production code and say the wrong
      // thing about a test.
      "files": ["src/**/*.test.ts", "src/**/*.spec.ts"],
      "rules": {
        // A helper defined inside the `it` that uses it is the point: a test
        // reads top to bottom, and hoisting `const pos = ...` to module scope
        // moves it away from the assertion it exists to explain. The rule's
        // rationale — avoiding a re-created closure per call — is a
        // micro-optimization no test needs.
        "unicorn/consistent-function-scoping": "off",
        // Building a mock means asserting that a hand-made object is the DOM
        // type under test — a fake HTMLVideoElement, a stub ImageBitmap. The
        // assertion is the mock. Honouring the rule would mean either shipping
        // the real type's full surface or routing through `unknown`, and both
        // are less honest than the cast.
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["src/ui/fileStash.ts"],
      "rules": {
        // IndexedDB's request/transaction objects are one-shot: assigning
        // onerror/onabort/onsuccess is the idiomatic (and MDN-documented) style,
        // not a lingering listener addEventListener would meaningfully improve.
        "unicorn/prefer-add-event-listener": "off"
      }
    }
  ]
}

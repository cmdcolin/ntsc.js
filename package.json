{
  "name": "ntsc.js",
  "private": true,
  "version": "0.7.3",
  "description": "Real-time NTSC / VHS / composite-video glitch simulator in WebGPU compute shaders.",
  "license": "MIT",
  "homepage": "https://cmdcolin.github.io/ntsc.js/",
  "repository": {
    "type": "git",
    "url": "https://github.com/cmdcolin/ntsc.js.git"
  },
  "keywords": [
    "webgpu",
    "ntsc",
    "vhs",
    "composite-video",
    "analog-video",
    "crt",
    "glitch",
    "video-synth",
    "wgsl",
    "compute-shader"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-guide.mjs",
    "preview": "vite preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "git-cliff --tag v$npm_package_version -o CHANGELOG.md && git add CHANGELOG.md",
    "push:patch": "node scripts/push.mjs patch",
    "push:minor": "node scripts/push.mjs minor",
    "push:major": "node scripts/push.mjs major",
    "logo": "node scripts/logo.mjs",
    "docshots": "node scripts/docshots.mjs",
    "guide": "node scripts/build-guide.mjs",
    "docs": "node scripts/diagrams.mjs",
    "docs:check": "node scripts/diagrams.mjs --check"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@webgpu/types": "^0.1.71",
    "babel-plugin-react-compiler": "^1.0.0",
    "git-cliff": "^2.13.1",
    "markdown-it": "^15.0.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "puppeteer-core": "^25.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}

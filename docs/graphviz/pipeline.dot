// ntsc.js signal path — mirrors the pass order in docs/ARCHITECTURE.md
// ("Pass order") and src/gpu/pipeline.ts: prePasses -> loopPasses x dubGens
// -> postPasses -> present.
//
// The `passes` attribute on each node names the pass(es) it stands for, and
// src/gpu/pipeline-graph.test.ts asserts that set equals the passes the engine
// actually builds — so a pass added to the pipeline and forgotten here fails
// the test rather than quietly rotting.
//
// Every arrow is labelled with the GPU buffer it carries, so the graph doubles
// as the buffer story: compA is the spine, chroma/under are side branches that
// rejoin it, compB exists only because `channel` cannot read and write one
// buffer at once. The last line of each pass is its dispatch — how many GPU
// threads run it.
//
// Colours are placeholder tokens — render with `pnpm run docs`, never `dot`
// directly. See scripts/diagrams.mjs.
digraph ntsc_js {
  rankdir=TB;
  bgcolor="transparent";
  compound=true;
  newrank=true;
  labelloc="t"; labeljust="l";
  fontname="Helvetica,Arial,sans-serif";
  node [shape=box style="rounded,filled" fontname="Helvetica,Arial,sans-serif"
        fontsize=11 color="@STROKE@" fontcolor="@FG@" penwidth=1];
  edge [fontname="Helvetica,Arial,sans-serif" fontsize=9 color="@EDGE@" fontcolor="@EDGE@"];

  // The key rides on the graph label rather than a floating node, so it does not
  // claim a layout column of its own. The SVG gets embedded and screenshotted
  // away from the prose that used to carry these conventions.
  label=<
    <table border="0" cellborder="0" cellspacing="2" cellpadding="3">
      <tr><td colspan="2" align="left"><font point-size="13" color="@FG@"><b>how to read this</b></font></td></tr>
      <tr><td bgcolor="@CH1@" width="34"></td>
          <td align="left"><font color="@FG@">the pass doing the work</font></td></tr>
      <tr><td bgcolor="@CH2@" width="34"></td>
          <td align="left"><font color="@FG@">its helper pass</font></td></tr>
      <tr><td align="right"><font color="@FG@">— — —</font></td>
          <td align="left"><font color="@FG@">border dashed: runs only when its control is engaged</font></td></tr>
      <tr><td align="right"><font color="@DUB@"><b>━━━</b></font></td>
          <td align="left"><font color="@FG@">repeats inside the same frame</font></td></tr>
      <tr><td align="right"><font color="@GOLD@">– – –</font> <font color="@GREEN@">– – –</font></td>
          <td align="left"><font color="@FG@">feedback: arrives one frame later</font></td></tr>
      <tr><td align="right"><font color="@EDGE@"><i>compA</i></font></td>
          <td align="left"><font color="@FG@">the GPU buffer the arrow carries</font></td></tr>
      <tr><td align="right"><font color="@EDGE@">754 × 480 px</font></td>
          <td align="left"><font color="@FG@">last line of a pass: how many GPU threads run it</font></td></tr>
    </table>
  >;

  // ---- sources -------------------------------------------------------------
  srcA [label="Source A\nbars · sweep · video · webcam" fillcolor="@SRC@"];
  srcB [label="Source B\nnon-genlocked" fillcolor="@SRC@"];

  // ---- encoder -------------------------------------------------------------
  subgraph cluster_enc {
    label="  ①  Encoder — build the composite signal  ";
    labeljust="l"; fontsize=12; fontcolor="@CLTEXT@";
    style="rounded,filled"; fillcolor="@ENCBG@"; color="@ENCLN@";
    compose    [passes="compose" fillcolor="@ENC2@"
                label="compose\n+ feedback camera\n754 × 480 px, 8×8 tiles"];
    encodeYuv  [passes="encodeYuv" fillcolor="@ENC2@"
                label="encodeYuv\nRGB → YUV\n754 × 480 px"];
    encodeComp [passes="encodeComposite" fillcolor="@ENC1@"
                label="encodeComposite\nY + chroma modulated on Fsc\nsync · burst · blanking\n525 lines × 910 samples"];
    composeB   [passes="composeB" fillcolor="@ENC2@" style="rounded,filled,dashed"
                label="composeB\n754 × 480 px, 8×8 tiles"];
    encodeYuvB [passes="encodeYuvB" fillcolor="@ENC2@" style="rounded,filled,dashed"
                label="encodeYuvB\n754 × 480 px"];
    encodeChromaB [passes="encodeChromaB" fillcolor="@ENC2@" style="rounded,filled,dashed"
                label="encodeChromaB\nB chroma bandlimit, precomputed\n754 × 480 px"];
    mixB       [passes="mixB" fillcolor="@ENC2@" style="rounded,filled,dashed"
                label="mixB\ndirty mix · ring · wipe · PiP\n525 lines × 910 samples"];
  }

  fbComposite [passes="fbComposite" fillcolor="@STORE@" style="rounded,filled,dashed"
               label="fbComposite\nhardware mixer loop\nkey · trails\n525 lines × 910 samples"];

  // ---- channel (repeats per dub generation) --------------------------------
  subgraph cluster_ch {
    label="  ②  Channel — the whole block runs again per tape dub  ";
    labeljust="l"; fontsize=12; fontcolor="@CLTEXT@";
    style="rounded,filled"; fillcolor="@CHBG@"; color="@CHLN@"; penwidth=2;
    chromaExtract [passes="chromaExtract" fillcolor="@CH2@"
                   label="chromaExtract\nbandpass chroma out\n525 lines × 910 samples"];
    underDown     [passes="underDown" fillcolor="@CH2@" style="rounded,filled,dashed"
                   label="underDown\nVHS color-under downconvert\n525 lines × 910 samples"];
    channel       [passes="channel" fillcolor="@CH1@"
                   label="channel\nluma LPF · noise · dropouts · ghost\nhum · head-switch · AGC\n525 lines × 910 samples"];
    timebase      [passes="timebase" fillcolor="@CH2@"
                   label="timebase\njitter / wow resample\n525 lines × 910 samples"];
  }

  // Outboard, so it is neither channel nor receiver: it runs after the last dub
  // and before anything measures sync, so the pulses it stamps are the pulses
  // the set has to lock to.
  enhancer [passes="enhancer" fillcolor="@OUT@" style="rounded,filled,dashed"
            label="enhancer — outboard box\nsharpening · pulse clamp · sync restamp\n525 lines, one thread each"];

  // ---- receiver ------------------------------------------------------------
  subgraph cluster_rx {
    label="  ③  Receiver — decode the damaged signal  ";
    labeljust="l"; fontsize=12; fontcolor="@CLTEXT@";
    style="rounded,filled"; fillcolor="@RXBG@"; color="@RXLN@";
    // Two passes in one box: syncMeasure reads an edge per line, then sync walks
    // the PLL over all of them in a single thread.
    sync        [passes="syncMeasure,sync" fillcolor="@RX2@"
                 label="syncMeasure → sync\nrecover H/V timing\n525 lines each, then 1 thread total"];
    lineAnalyze [passes="lineAnalyze" fillcolor="@RX2@"
                 label="lineAnalyze\nper-line burst phase & lock\n525 lines, one thread each"];
    decode      [passes="decode" fillcolor="@RX1@"
                 label="decode\ncomb filter · chroma demod · color-kill\ndeflection bend · sag → RGB\n754 × 480 px"];
  }

  storePrev [passes="storePrev" fillcolor="@STORE@" style="rounded,filled,dashed"
             label="storePrev\nframe store · strobe hold\n525 lines × 910 samples"];
  crtFace   [passes="crtFace" fillcolor="@DSP@"
             label="crtFace\nglowing tube face\nbloom · halation · gamma\n754 × 480 px, 8×8 tiles"];
  present   [fillcolor="@DSP@"
             label="present\nscanline beam → canvas\nrender pass, not compute"];

  // ---- signal flow ---------------------------------------------------------
  srcA -> compose;
  compose -> encodeYuv [label="  frameTex"];
  encodeYuv -> encodeComp [label="  yuv"];
  encodeComp -> mixB [label="  compA"];
  srcB -> composeB;
  composeB -> encodeYuvB [label="  texB"];
  encodeYuvB -> encodeChromaB [label="  yuvB"];
  encodeYuvB -> mixB [label="  yuvB"];
  encodeChromaB -> mixB [label="  uvfB"];
  mixB -> fbComposite [label="  compA"];

  // compA feeds the channel directly; chroma is a side branch that rejoins it,
  // it is not in line with the luma.
  fbComposite -> channel [label="  compA"];
  fbComposite -> chromaExtract [label="  compA"];
  chromaExtract -> underDown [label="  chroma"];
  chromaExtract -> channel [label="  chroma"];
  underDown -> channel [label="  under"];
  channel -> timebase [label="  compB"];
  timebase -> chromaExtract [label="  ×dubGens (≤4)\l" style=bold penwidth=2.2
                             color="@DUB@" fontcolor="@DUB@" constraint=false];

  timebase -> enhancer [label="  compA"];
  enhancer -> sync [label="  compA" lhead=cluster_rx];
  sync -> lineAnalyze [label="  timing[]"];
  lineAnalyze -> decode [label="  lineInfo[]"];
  decode -> crtFace [label="  outTex"];
  crtFace -> present [label="  faceTex"];
  enhancer -> storePrev [label="  compA — the same waveform\l  the receiver locked to\l"];

  // ---- feedback loops (one frame of delay) ---------------------------------
  storePrev -> fbComposite [label="  compPrev\l  next frame\l" style=dashed
                            color="@GOLD@" fontcolor="@GOLD@" constraint=false];
  crtFace -> compose [label="  faceTex\l  camera-at-monitor\l" style=dashed
                      color="@GREEN@" fontcolor="@GREEN@" constraint=false];
}
